# Copy this file to .env and fill the two values locally.
# Never commit or send the secret key.
JD_APP_KEY=
JD_APP_SECRET=
# For social-media promotion: siteId is the media ID; positionId is the
# promotion-position ID. They are different values in JD Union.
JD_SITE_ID=
JD_POSITION_ID=

# demo: use built-in sample data; live: call JD Union API
JD_MODE=demo
JD_SCAN_INTERVAL_MINUTES=30
JD_DISCOVERY_PAGES=20
JD_DROP_THRESHOLD_PERCENT=15
JD_HOST=127.0.0.1
JD_PORT=8765

